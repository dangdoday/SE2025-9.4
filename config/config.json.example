{
    "$schema": "https://schema.binancebot.local/schema.json",
    "max_open_trades": 10,
    "stake_currency": "USDT",
    "stake_amount": 30,
    "tradable_balance_ratio": 0.99,
    "timeframe": "5m",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": { "entry": 10, "exit": 10, "exit_timeout_count": 0, "unit": "minutes" },
    "entry_pricing": { "price_side": "same", "use_order_book": true, "order_book_top": 1 },
    "exit_pricing": { "price_side": "same", "use_order_book": true, "order_book_top": 1 },
    "exchange": {
        "name": "binance",
        "key": "YOUR_API_KEY_HERE",
        "secret": "YOUR_SECRET_HERE",
        "ccxt_config": { "options": { "defaultType": "spot" }, "sandbox": false },
        "ccxt_async_config": { "options": { "defaultType": "spot" }, "sandbox": false },
        "pair_whitelist": ["BTC/USDT","ETH/USDT","BNB/USDT"],
        "pair_blacklist": []
    },
    "pairlists": [{ "method": "StaticPairList" }],
    "telegram": { "enabled": false, "token": "YOUR_TOKEN", "chat_id": "YOUR_CHAT_ID" },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 2907,
        "verbosity": "error",
        "jwt_secret_key": "REPLACE_WITH_SECURE_VALUE",
        "CORS_origins": ["http://localhost:3000","http://localhost:2907","http://127.0.0.1:2907","https://your.domain.tld"],
        "username": "binancebot",
        "password": "changeme",
        "users": [{ "username": "dangdoday", "password": "<hashed-password>" }]
    },
    "bot_name": "binancebot",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": { "process_throttle_secs": 5 },
    "strategy": "RSI_EMA",
    "strategy_path": "strategies",
    "trading_mode": "spot"
}
{
    "$schema": "https://schema.binancebot.local/schema.json",
    "max_open_trades": 10,
    "stake_currency": "USDT",
    "stake_amount": 5,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "5m",
    "dry_run": false,
    "dry_run_wallet": 5000,
    "exchange": {
        "name": "binance",
        "key": "NHẬP_API_KEY_CỦA_BẠN_VÀO_ĐÂY",
        "secret": "NHẬP_SECRET_KEY_CỦA_BẠN_VÀO_ĐÂY",
        "ccxt_config": {
            "options": {
                "defaultType": "spot",
                "adjustForTimeDifference": true
            },
            "sandbox": false
        }
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 2907,
        "username": "admin",
        "password": "pass789"
    },
    "strategy": "RSI_EMA",
    "trading_mode": "spot"
}
